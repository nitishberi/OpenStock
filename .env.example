# OpenStock / Auto Day Trader — copy to .env and fill in secrets.
# Never commit real keys. Default Alpaca mode is paper; no auto live trades.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Better Auth)
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Mongo
MONGODB_URI=mongodb://root:example@mongodb:27017/openstock?authSource=admin

# Finnhub
NEXT_PUBLIC_FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
# FINNHUB_API_KEYS=key_one,key_two
# NEXT_PUBLIC_OPENSTOCK_DATA_MODE=cached

# AI (Gemini default)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# MINIMAX_API_KEY=
# SIRAY_API_KEY=

# Email (optional)
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Inngest (optional local/cloud)
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# --- Auto Day Trader additions ---

# Alpaca trading (default PAPER). Live requires ALPACA_MODE=live AND ALPACA_ALLOW_LIVE=true
# plus explicit UI Approve. Orders are NEVER auto-submitted from cron.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_MODE=paper
ALPACA_ALLOW_LIVE=false
ALPACA_LIVE_CONFIRM_PHRASE=LIVE
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# ALPACA_DATA_FEED=iex

# News discovery (DSA-style multi-source). Tavily primary; Brave/SerpAPI fallback.
TAVILY_API_KEY=
# TAVILY_API_KEYS=
BRAVE_API_KEY=
# BRAVE_API_KEYS=
SERPAPI_API_KEY=
# SERPAPI_API_KEYS=

# Scrapling worker (news + social + press body fetch; OpenInsider Form 4 tables)
SCRAPLING_WORKER_URL=http://localhost:8091
SCRAPLING_WORKER_TOKEN=change-me-in-production
# Worker → Next ingest (compose sets these; optional for local worker)
# WEB_INGEST_URL=http://localhost:3000/api/media/ingest
# WEB_INSIDER_INGEST_URL=http://localhost:3000/api/insider/ingest

# Proposal alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=

# Social channel for forecasts: Tavily/RSS discovery → Scrapling → local VADER.
# No Adanos / paid social API required. Do not scrape login walls (X/Twitter login, etc.).

# Prediction-first product flags
# Trading Approve/Alpaca chrome stays in repo but is OFF by default.
TRADING_UI_ENABLED=false
# NEXT_PUBLIC_TRADING_UI_ENABLED=false
# GEMINI_MODEL=gemini-3.8-flash
