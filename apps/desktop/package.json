{
  "name": "@autodaytrader/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AutoDayTrader macOS desktop runtime — Hono API + Vite SPA + SQLite",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-localhost.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "better-auth": "^1.3.25",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.7.5",
    "nodemailer": "^7.0.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.5.0",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^6.2.5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
